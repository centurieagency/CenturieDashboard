# Générer avec : npx auth secret   (ou  openssl rand -base64 32)
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google OAuth — https://console.cloud.google.com/apis/credentials
# URI de redirection autorisée : http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL (Neon) — URL de connexion poolée
DATABASE_URL=

# API Centurie (token admin, serveur uniquement)
CENTURIE_API_TOKEN=

# Stripe (clé secrète, serveur uniquement) — sk_test_... en développement
STRIPE_SECRET_KEY=
